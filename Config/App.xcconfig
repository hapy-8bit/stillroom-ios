// Keep the developer team local; the app has its own identity on the phone.
#include? "Signing.local.xcconfig"
PRODUCT_BUNDLE_IDENTIFIER = com.liuhang.stillroom
MARKETING_VERSION = 0.4.0
CURRENT_PROJECT_VERSION = 100
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
TARGETED_DEVICE_FAMILY = 1
CODE_SIGN_STYLE = Automatic
INFOPLIST_FILE = Stillroom/App/Info.plist
CODE_SIGN_ENTITLEMENTS = Stillroom/App/Stillroom.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ENABLE_USER_SCRIPT_SANDBOXING = YES
GENERATE_INFOPLIST_FILE = NO

