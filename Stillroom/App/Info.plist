	<array>
		<string>Damion-Regular.ttf</string>
		<string>GeistMono-Regular.ttf</string>
		<string>GeistPixel-Square.ttf</string>
		<string>RacingSansOne-Regular.ttf</string>
		<string>InstrumentSerif-Regular.ttf</string>
		<string>InstrumentSerif-Italic.ttf</string>
		<string>DMSans-Regular.ttf</string>
		<string>DMSans-Medium.ttf</string>
		<string>DMMono-Regular.ttf</string>
		<string>CormorantGaramond-MediumItalic.ttf</string>
		<string>SpaceGrotesk-Medium.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
